<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>Two Guys Stranded</title>

<style>
*{box-sizing:border-box}

body{
  margin:0;
  font-family:Arial,sans-serif;
  background:#0b1020;
  color:white;
}

button{
  font:inherit;
  cursor:pointer;
  border:0;
  border-radius:10px;
  padding:10px 14px;
  background:#2d6cdf;
  color:white;
}

button.secondary{
  background:#27304c;
}

#intro{
  position:fixed;
  inset:0;
  background:#000;
  display:flex;
  align-items:center;
  justify-content:center;
  z-index:20;
  overflow:hidden;
}

#introTitle{
  font-size:clamp(24px,7vw,86px);
  font-weight:900;
  letter-spacing:4px;
  transform:scale(.05);
  opacity:0;
  animation:zoomTitle 2.8s ease-out forwards;
}

@keyframes zoomTitle{
  0%{
    transform:scale(.05);
    opacity:0;
  }
  20%{
    opacity:1;
  }
  100%{
    transform:scale(1);
    opacity:1;
  }
}

#app{
  display:none;
  min-height:100vh;
}

header{
  padding:22px 5%;
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:20px;
  background:#111936;
  position:sticky;
  top:0;
  z-index:10;
}

.logo{
  font-weight:900;
  letter-spacing:2px;
}

.hero{
  text-align:center;
  padding:55px 20px 35px;
  background:linear-gradient(180deg,#16244d,#0b1020);
}

.hero h1{
  font-size:clamp(34px,6vw,64px);
  margin:0 0 10px;
}

.hero p{
  color:#b9c3df;
  margin:0;
}

.library{
  max-width:1200px;
  margin:auto;
  padding:35px 5% 70px;
}

.grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(190px,1fr));
  gap:24px;
}

.book{
  background:#151d37;
  border-radius:16px;
  padding:14px;
  box-shadow:0 10px 30px #0005;
  transition:.2s;
}

.book:hover{
  transform:translateY(-5px);
}

.cover{
  width:100%;
  aspect-ratio:2/3;
  border-radius:10px;
  object-fit:cover;
  background:linear-gradient(145deg,#314b7d,#111827);
  display:flex;
  align-items:center;
  justify-content:center;
  text-align:center;
  padding:15px;
  font-weight:900;
}

.cover img{
  width:100%;
  height:100%;
  object-fit:cover;
  border-radius:10px;
}

.book h3{
  margin:13px 2px 5px;
}

.book p{
  margin:0 2px 12px;
  color:#aeb9d8;
  font-size:14px;
}

.book button{
  width:100%;
}

#reader{
  display:none;
  min-height:100vh;
  background:#f4f1e8;
  color:#202020;
}

.readerTop{
  position:sticky;
  top:0;
  background:#171d2d;
  color:white;
  padding:14px 5%;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
  z-index:5;
}

.readerControls{
  display:flex;
  gap:7px;
  flex-wrap:wrap;
}

.progressWrap{
  height:6px;
  background:#39435d;
}

#progress{
  height:100%;
  width:0;
  background:#5f8ff7;
  transition:.2s;
}

.readerBody{
  max-width:850px;
  margin:auto;
  padding:45px 22px 90px;
}

.readerBody h1{
  text-align:center;
  font-size:38px;
}

.readerBody h2{
  text-align:center;
  color:#59657c;
}

#chapterText{
  font-family:Georgia,serif;
  font-size:20px;
  line-height:1.8;
}

#chapterText p{
  margin:0 0 1.2em;
}

.selectWrap{
  text-align:center;
  margin:20px 0;
}

select{
  padding:10px;
  border-radius:8px;
  font-size:16px;
}

.nav{
  display:flex;
  justify-content:space-between;
  gap:12px;
  margin-top:35px;
}

.nav button{
  flex:1;
}

.status{
  text-align:center;
  color:#667085;
  font-size:13px;
  margin-top:12px;
}

@media(max-width:600px){
  .readerTop{
    align-items:flex-start;
    flex-direction:column;
  }

  .readerBody h1{
    font-size:30px;
  }

  #chapterText{
    font-size:18px;
  }
}
</style>
</head>

<body>

<div id="intro">
  <div id="introTitle">TWO GUYS STRANDED</div>
</div>

<div id="app">

<header>
  <div class="logo">TWO GUYS STRANDED</div>

  <button class="secondary" onclick="toggleTheme()">
    Reading Theme
  </button>
</header>

<section class="hero">
  <h1>Two Guys Stranded</h1>
  <p>Read the adventures of Paxman and Sam.</p>
</section>

<main class="library">
  <div class="grid" id="bookGrid"></div>
</main>

</div>

<section id="reader">

  <div class="readerTop">

    <button class="secondary" onclick="closeReader()">
      ← Library
    </button>

    <strong id="readerBook"></strong>

    <div class="readerControls">
      <button class="secondary" onclick="changeFont(-1)">
        A−
      </button>

      <button class="secondary" onclick="changeFont(1)">
        A+
      </button>
    </div>

  </div>

  <div class="progressWrap">
    <div id="progress"></div>
  </div>

  <div class="readerBody">

    <h1 id="chapterHeading"></h1>

    <div class="selectWrap">
      <select id="chapterSelect" onchange="goToChapter(this.value)">
      </select>
    </div>

    <div id="chapterText"></div>

    <div class="nav">

      <button id="prevBtn" onclick="previousChapter()">
        ← Previous
      </button>

      <button id="nextBtn" onclick="nextChapter()">
        Next →
      </button>

    </div>

    <div class="status" id="status"></div>

  </div>

</section>

<script>

const books = [

  {
    id:1,
    title:"Book 1",
    subtitle:"Two Guys Stranded",
    file:"books/book1.txt",
    cover:"covers/book1.jpg"
  },

  {
    id:2,
    title:"Book 2",
    subtitle:"The Hidden Lab",
    file:"books/book2.txt",
    cover:"covers/book2.jpg"
  },

  {
    id:3,
    title:"Book 3",
    subtitle:"The Hidden Lab",
    file:"books/book3.txt",
    cover:"covers/book3.jpg"
  },

  {
    id:4,
    title:"Book 4",
    subtitle:"The Core Crystal",
    file:"books/book4.txt",
    cover:"covers/book4.jpg"
  },

  {
    id:5,
    title:"Book 5",
    subtitle:"The Final Odyssey",
    file:"books/book5.txt",
    cover:"covers/book5.jpg"
  },

  {
    id:6,
    title:"Book 6",
    subtitle:"The Clone",
    file:"books/book6.txt",
    cover:"covers/book6.jpg"
  }

];

let loaded={};

let currentBook=null;

let currentChapter=0;

let fontSize=Number(
  localStorage.getItem("tgs-font") || 20
);


function renderLibrary(){

  const grid=document.getElementById("bookGrid");

  grid.innerHTML=books.map(b=>`

    <article class="book">

      <div class="cover">

        <img
          src="${b.cover}"
          alt="${b.title} cover"

          onerror="
            this.style.display='none';
            this.parentElement.innerHTML='<span>${b.title}<br><br>${b.subtitle}</span>'
          "
        >

      </div>

      <h3>${b.title}</h3>

      <p>${b.subtitle}</p>

      <button onclick="openBook(${b.id})">
        Read Book
      </button>

    </article>

  `).join("");

}


function parseChapters(text){

  text=text.replace(/\r/g,"");

  const lines=text.split("\n");

  const chapters=[];

  let current=null;

  for(const raw of lines){

    const line=raw.trim();

    let match=line.match(
      /^#?\s*CHAPTER\s+(\d+)\s*(?:[-—:]\s*(.*))?$/i
    );

    if(!match){

      match=line.match(
        /^#?\s*Chapter\s+(\d+)\s*(?:[-—:]\s*(.*))?$/i
      );

    }

    if(match){

      if(current){
        chapters.push(current);
      }

      current={
        number:Number(match[1]),
        title:(match[2]||"").trim(),
        lines:[]
      };

      continue;
    }

    if(
      current &&
      !current.title &&
      line &&
      !/^#/.test(line)
    ){

      current.title=
        line.replace(/^#+\s*/,"").trim();

      continue;
    }

    if(current){
      current.lines.push(raw);
    }

  }

  if(current){
    chapters.push(current);
  }

  return chapters.map(c=>{

    let text=c.lines.join("\n").trim();

    text=text.replace(/^##\s*/gm,"");

    return {
      ...c,
      text:text
    };

  });

}


async function openBook(id){

  const book=books.find(x=>x.id===id);

  if(!book)return;

  document.getElementById("app").style.display="none";

  document.getElementById("reader").style.display="block";

  document.getElementById("readerBook").textContent=
    `${book.title} — ${book.subtitle}`;

  try{

    if(!loaded[id]){

      const response=await fetch(book.file);

      if(!response.ok){
        throw new Error("File not found");
      }

      const text=await response.text();

      loaded[id]=parseChapters(text);

    }

    if(!loaded[id].length){
      throw new Error("No chapters found");
    }

    currentBook=id;

    const saved=Number(
      localStorage.getItem(`tgs-book-${id}`) || 0
    );

    currentChapter=Math.min(
      saved,
      loaded[id].length-1
    );

    buildChapterMenu();

    renderChapter();

  }

  catch(error){

    document.getElementById("chapterHeading").textContent=
      "Book file not found";

    document.getElementById("chapterText").textContent=
      `Add ${book.file} to your GitHub repository, then reload the site.`;

    document.getElementById("chapterSelect").innerHTML="";

    document.getElementById("status").textContent="";

  }

}


function buildChapterMenu(){

  const select=
    document.getElementById("chapterSelect");

  select.innerHTML=
    loaded[currentBook].map((chapter,index)=>`

      <option value="${index}">
        Chapter ${chapter.number}
        ${chapter.title ? " — "+chapter.title : ""}
      </option>

    `).join("");

}


function renderChapter(){

  const chapters=loaded[currentBook];

  const chapter=chapters[currentChapter];

  document.getElementById("chapterSelect").value=
    currentChapter;

  document.getElementById("chapterHeading").textContent=
    `Chapter ${chapter.number}${chapter.title ? " — "+chapter.title : ""}`;

  const container=
    document.getElementById("chapterText");

  container.innerHTML="";

  chapter.text
    .split(/\n\s*\n/)
    .filter(x=>x.trim())
    .forEach(block=>{

      const p=document.createElement("p");

      p.textContent=block.trim();

      container.appendChild(p);

    });

  container.style.fontSize=
    fontSize+"px";

  document.getElementById("prevBtn").disabled=
    currentChapter===0;

  document.getElementById("nextBtn").disabled=
    currentChapter===chapters.length-1;

  const percent=
    ((currentChapter+1)/chapters.length)*100;

  document.getElementById("progress").style.width=
    percent+"%";

  document.getElementById("status").textContent=
    `Chapter ${currentChapter+1} of ${chapters.length}`;

  localStorage.setItem(
    `tgs-book-${currentBook}`,
    currentChapter
  );

}


function goToChapter(index){

  currentChapter=Number(index);

  renderChapter();

  window.scrollTo(0,0);

}


function previousChapter(){

  if(currentChapter>0){

    currentChapter--;

    renderChapter();

    window.scrollTo(0,0);

  }

}


function nextChapter(){

  if(
    currentChapter<
    loaded[currentBook].length-1
  ){

    currentChapter++;

    renderChapter();

    window.scrollTo(0,0);

  }

}


function closeReader(){

  document.getElementById("reader").style.display="none";

  document.getElementById("app").style.display="block";

}


function changeFont(amount){

  fontSize=Math.max(
    14,
    Math.min(30,fontSize+amount)
  );

  localStorage.setItem(
    "tgs-font",
    fontSize
  );

  document.getElementById("chapterText").style.fontSize=
    fontSize+"px";

}


function toggleTheme(){

  const reader=
    document.getElementById("reader");

  if(
    reader.style.background==="rgb(11, 16, 32)"
  ){

    reader.style.background="#f4f1e8";

    reader.style.color="#202020";

  }else{

    reader.style.background="#0b1020";

    reader.style.color="#fff";

  }

}


renderLibrary();


setTimeout(()=>{

  document.getElementById("intro").style.display="none";

  document.getElementById("app").style.display="block";

},3200);

</script>

</body>
</html>
