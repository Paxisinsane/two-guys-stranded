/* =====================================
   CURRENT READER
===================================== */

let currentBook = 0;
let currentChapter = 0;


/* =====================================
   OPEN BOOK
===================================== */

function openBook(bookNumber){

    currentBook = bookNumber;
    currentChapter = 0;

    document.getElementById("home").style.display = "none";
    document.getElementById("reader").style.display = "block";

    document.title =
        books[currentBook].title +
        " — Two Guys Stranded";

    loadBook();

    window.scrollTo({
        top:0,
        behavior:"smooth"
    });
}


/* =====================================
   LOAD BOOK
===================================== */

function loadBook(){

    const book = books[currentBook];

    document.getElementById("readerBookTitle").textContent =
        book.title + " — " + book.number;

    const select =
        document.getElementById("chapterSelect");

    select.innerHTML = "";

    book.chapters.forEach((chapter,index)=>{

        const option =
            document.createElement("option");

        option.value = index;

        option.textContent = chapter.title;

        select.appendChild(option);

    });

    select.value = currentChapter;

    loadChapter();
}


/* =====================================
   LOAD CHAPTER
===================================== */

function loadChapter(){

    const book = books[currentBook];
    const chapter = book.chapters[currentChapter];

    document.getElementById("chapterTitle").textContent =
        chapter.title;

    const textArea =
        document.getElementById("bookText");

    textArea.innerHTML = "";

    chapter.text.forEach(paragraph=>{

        const p =
            document.createElement("p");

        p.textContent = paragraph;

        textArea.appendChild(p);

    });

    document.getElementById("chapterSelect").value =
        currentChapter;

    document.getElementById("previousButton").disabled =
        currentChapter === 0;

    document.getElementById("nextButton").disabled =
        currentChapter === book.chapters.length - 1;

    const progress =
        ((currentChapter + 1) / book.chapters.length) * 100;

    document.getElementById("progressFill").style.width =
        progress + "%";

    document.getElementById("progressText").textContent =
        "Chapter " +
        (currentChapter + 1) +
        " of " +
        book.chapters.length;

    window.scrollTo({
        top:0,
        behavior:"smooth"
    });
}


/* =====================================
   CHAPTER NAVIGATION
===================================== */

function nextChapter(){

    const book = books[currentBook];

    if(currentChapter < book.chapters.length - 1){

        currentChapter++;

        loadChapter();

    }
}


function previousChapter(){

    if(currentChapter > 0){

        currentChapter--;

        loadChapter();

    }
}


function changeChapter(value){

    currentChapter =
        Number(value);

    loadChapter();
}


/* =====================================
   CLOSE READER
===================================== */

function closeReader(){

    document.getElementById("reader").style.display =
        "none";

    document.getElementById("home").style.display =
        "block";

    window.scrollTo({
        top:0,
        behavior:"smooth"
    });
}


/* =====================================
   HOME
===================================== */

function goHome(){

    closeReader();

}


/* =====================================
   LIBRARY
===================================== */

function showLibrary(){

    document.getElementById("reader").style.display =
        "none";

    document.getElementById("home").style.display =
        "block";

    window.scrollTo({
        top:document.querySelector(".section").offsetTop - 80,
        behavior:"smooth"
    });

}


