<title>Two Guys Stranded — The Official Reader</title>

<style>
*{
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    margin:0;
    font-family:Georgia, "Times New Roman", serif;
    background:#080b12;
    color:white;
}

/* =========================
   OPENING
========================= */

#intro{
    position:fixed;
    inset:0;
    background:
        radial-gradient(circle at center,#17243d 0%,#080b12 55%,#020307 100%);
    display:flex;
    align-items:center;
    justify-content:center;
    z-index:9999;
    overflow:hidden;
    animation:introFade 1s ease 5.5s forwards;
}

.intro-title{
    text-align:center;
    font-family:Arial,sans-serif;
    font-weight:900;
    letter-spacing:8px;
    font-size:12px;
    transform:scale(.05);
    opacity:0;
    animation:
        titleAppear .7s ease forwards,
        titleZoom 4.2s cubic-bezier(.15,.75,.2,1) .7s forwards;
}

.intro-title .two{
    display:block;
}

.intro-title .guys{
    display:block;
}

.intro-title .stranded{
    display:block;
    margin-top:8px;
}

@keyframes titleAppear{
    from{
        opacity:0;
    }
    to{
        opacity:1;
    }
}

@keyframes titleZoom{
    0%{
        transform:scale(.05);
        opacity:0;
    }

    15%{
        opacity:1;
    }

    75%{
        transform:scale(3);
        opacity:1;
    }

    100%{
        transform:scale(6);
        opacity:1;
    }
}

@keyframes introFade{
    to{
        opacity:0;
        visibility:hidden;
        pointer-events:none;
    }
}

/* =========================
   HEADER
========================= */

header{
    position:sticky;
    top:0;
    z-index:100;
    background:rgba(5,8,14,.94);
    backdrop-filter:blur(12px);
    border-bottom:1px solid rgba(255,255,255,.1);
    padding:16px 25px;
}

.header-inner{
    max-width:1200px;
    margin:auto;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:20px;
}

.logo{
    font-family:Arial,sans-serif;
    font-weight:900;
    letter-spacing:3px;
    font-size:20px;
}

.logo span{
    display:block;
    font-size:10px;
    letter-spacing:2px;
    color:#aebbd3;
    margin-top:3px;
}

nav{
    display:flex;
    gap:10px;
}

nav button{
    border:0;
    background:transparent;
    color:white;
    padding:10px 14px;
    border-radius:8px;
    cursor:pointer;
    font-weight:bold;
}

nav button:hover{
    background:#182338;
}

/* =========================
   HOME
========================= */

#home{
    min-height:100vh;
}

.hero{
    min-height:420px;
    display:flex;
    align-items:center;
    justify-content:center;
    text-align:center;
    padding:70px 20px;
    background:
        linear-gradient(rgba(5,9,18,.35),rgba(5,9,18,.9)),
        radial-gradient(circle at 50% 35%,#27466a,#0a101c 65%);
}

.hero h1{
    font-family:Arial,sans-serif;
    font-size:clamp(42px,8vw,92px);
    line-height:.95;
    letter-spacing:5px;
    margin:0;
    text-shadow:0 10px 40px rgba(0,0,0,.7);
}

.hero p{
    color:#b9c5d9;
    font-size:18px;
    margin-top:25px;
}

.section{
    max-width:1200px;
    margin:auto;
    padding:65px 25px;
}

.section-title{
    font-size:34px;
    margin:0 0 10px;
}

.section-subtitle{
    color:#99a7bc;
    margin-bottom:35px;
}

/* =========================
   BOOK GRID
========================= */

.book-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:30px;
}

.book-card{
    background:linear-gradient(145deg,#111927,#0c111b);
    border:1px solid rgba(255,255,255,.09);
    border-radius:16px;
    padding:18px;
    transition:.25s;
    box-shadow:0 15px 40px rgba(0,0,0,.25);
}

.book-card:hover{
    transform:translateY(-7px);
    border-color:rgba(255,255,255,.25);
}

.cover{
    width:100%;
    aspect-ratio:2/3;
    border-radius:9px;
    overflow:hidden;
    position:relative;
    background:#151d2b;
    box-shadow:0 15px 30px rgba(0,0,0,.45);
}

.cover img{
    width:100%;
    height:100%;
    object-fit:cover;
    display:block;
}

.cover-art{
    width:100%;
    height:100%;
    display:flex;
    flex-direction:column;
    justify-content:space-between;
    align-items:center;
    padding:25px 15px;
    text-align:center;
    background:
        radial-gradient(circle at 50% 30%,#315d80,#0c1625 65%);
}

.cover-art .small{
    font-size:12px;
    letter-spacing:3px;
    font-family:Arial,sans-serif;
}

.cover-art .big{
    font-family:Arial,sans-serif;
    font-size:27px;
    font-weight:900;
    letter-spacing:2px;
}

.cover-art .book-number{
    font-size:14px;
    letter-spacing:2px;
}

.cover-5{
    background:
        linear-gradient(rgba(5,9,15,.15),rgba(5,9,15,.7)),
        radial-gradient(circle at 50% 25%,#60718a,#172130 60%,#05080d);
}

.cover-6{
    background:
        linear-gradient(rgba(5,9,15,.1),rgba(5,9,15,.65)),
        radial-gradient(circle at 50% 25%,#f1a16b,#52667a 35%,#101927 75%);
}

.book-card h3{
    margin:18px 0 7px;
    font-size:21px;
}

.book-card p{
    color:#9ba8ba;
    margin:0 0 17px;
}

.read-btn{
    width:100%;
    border:0;
    padding:13px;
    border-radius:9px;
    background:white;
    color:#070a10;
    font-weight:900;
    cursor:pointer;
    font-size:15px;
}

.read-btn:hover{
    background:#dbe7ff;
}

/* =========================
   READER
========================= */

#reader{
    display:none;
    min-height:100vh;
    background:#f3eee4;
    color:#171717;
}

.reader-top{
    position:sticky;
    top:0;
    z-index:20;
    background:#11151d;
    color:white;
    padding:13px 20px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:15px;
}

.reader-top button{
    border:0;
    background:#273245;
    color:white;
    padding:9px 14px;
    border-radius:7px;
    cursor:pointer;
}

.reader-title{
    font-weight:bold;
    overflow:hidden;
    text-overflow:ellipsis;
    white-space:nowrap;
}

.reader-wrap{
    max-width:850px;
    margin:auto;
    padding:50px 25px 100px;
}

.chapter-title{
    text-align:center;
    font-size:38px;
    margin:10px 0 35px;
}

.book-text{
    background:#fffdf8;
    padding:55px clamp(25px,7vw,80px);
    box-shadow:0 10px 40px rgba(0,0,0,.12);
    border-radius:3px;
    min-height:500px;
}

.book-text p{
    font-size:19px;
    line-height:1.9;
    margin:0 0 25px;
}

.reader-controls{
    display:flex;
    justify-content:space-between;
    gap:15px;
    margin-top:25px;
}

.reader-controls button{
    border:0;
    background:#11151d;
    color:white;
    padding:13px 20px;
    border-radius:8px;
    cursor:pointer;
}

.reader-controls button:disabled{
    opacity:.3;
    cursor:not-allowed;
}

.progress-area{
    margin-top:25px;
}

.progress-bar{
    height:6px;
    background:#ccd0d7;
    border-radius:20px;
    overflow:hidden;
}

.progress-fill{
    height:100%;
    background:#273b5d;
    width:0%;
    transition:.3s;
}

.progress-text{
    font-family:Arial,sans-serif;
    font-size:12px;
    color:#6c7280;
    margin-top:7px;
}

/* =========================
   CHAPTER MENU
========================= */

.chapter-menu{
    margin-bottom:30px;
}

.chapter-menu select{
    width:100%;
    padding:13px;
    border-radius:8px;
    border:1px solid #bbb;
    font-size:16px;
}

/* =========================
   ABOUT
========================= */

.about{
    border-top:1px solid rgba(255,255,255,.08);
    background:#05070b;
}

.about p{
    max-width:750px;
    color:#9da9ba;
    line-height:1.8;
}

/* =========================
   MOBILE
========================= */

@media(max-width:850px){

    .book-grid{
        grid-template-columns:repeat(2,1fr);
    }

}

@media(max-width:600px){

    header{
        padding:13px 15px;
    }

    .header-inner{
        align-items:flex-start;
    }

    nav button{
        padding:8px;
        font-size:12px;
    }

    .book-grid{
        grid-template-columns:1fr;
    }

    .hero{
        min-height:350px;
    }

    .book-text{
        padding:35px 22px;
    }

    .book-text p{
        font-size:18px;
    }

    .reader-controls button{
        padding:11px;
    }

}

/* =========================
